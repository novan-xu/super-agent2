{
  "name": "@super-agent2/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "mail-filter-dry-run": "node dist/mail-filter-dry-run.js",
    "voice:smoke": "node dist/voice-smoke-cli.js"
  },
  "dependencies": {
    "@super-agent2/catalog": "workspace:*",
    "@super-agent2/programs": "workspace:*",
    "@super-agent2/protocol": "workspace:*",
    "@super-agent2/routing": "workspace:*",
    "cron-parser": "5.10.6",
    "jose": "6.2.17",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2"
  }
}
