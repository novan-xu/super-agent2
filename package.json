{
  "name": "super-agent2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "local": "node packages/local/start.mjs",
    "comments": "node tools/zero-comment/dist/cli.js",
    "markup": "node tools/markup-text/dist/cli.js",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:local && pnpm comments && pnpm markup && pnpm sentences && pnpm layout",
    "test:local": "node --test packages/local/test/smoke.mjs",
    "browser:install": "node tools/page-dev/src/chromium.ts",
    "layout": "node tools/page-dev/dist/browser.js check",
    "screenshot": "node tools/page-dev/dist/browser.js screenshot",
    "sentences": "node tools/sentence-lines/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
